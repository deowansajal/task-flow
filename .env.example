# Local development only. Copy to .env and choose a password before starting Docker.
POSTGRES_USER=taskflow
POSTGRES_PASSWORD=replace-with-a-local-password
DATABASE_URL=postgresql://taskflow:replace-with-a-local-password@localhost:5432/taskflow
TEST_DATABASE_URL=postgresql://taskflow:replace-with-a-local-password@localhost:5433/taskflow_test
